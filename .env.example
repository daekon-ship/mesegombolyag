# Mesegombolyag szerver — minta beállítások. Másold .env néven, és töltsd ki.
# A .env fájl titkos adatokat tartalmaz: soha ne kerüljön git-be.

PORT=3001
NODE_ENV=development
# Production módban kötelező, legalább 32 véletlen karakter (pl. `openssl rand -hex 32`)
JWT_SECRET=

# Első indításkor ebből jön létre az admin felhasználó (ha még nincs admin az adatbázisban)
ADMIN_USERNAME=mesegombolyag
ADMIN_PASSWORD=
# Johanna értesítéseinek címe (új foglalás, jelentkezés, érdeklődés)
ADMIN_EMAIL=mesegombolyag@gmail.com

# A nyilvános oldal címe — a levelekben szereplő hivatkozásokhoz (lemondás, admin)
PUBLIC_SITE_URL=http://localhost:4173/mesegombolyag

# Levélküldés: smtp | file (levélfogó: data/mail-capture) | fail (hibateszt) | disabled
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=mesegombolyag@gmail.com

# Opcionális
# DATA_DIR=./data            # adatbázis, feltöltött képek, levélfogó helye
# DB_PATH=./data/mesegombolyag.db
# CORS_ORIGINS=https://pelda.hu   # csak ha a frontend más domainről hívja az API-t
# TRUST_PROXY=1                   # reverse proxy (pl. nginx) mögött
