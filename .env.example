# Mesegombolyag — környezeti változók (MINTA, titkos érték nélkül).
# Helyi fejlesztéshez másold .env néven. Élesben (Railway) a Variables felületen add meg őket.
# A .env és minden valódi titok soha ne kerüljön git-be.

# --- Alap ---------------------------------------------------------------
# PORT: Railway automatikusan adja; helyben 3001.
PORT=3001
# HOST=0.0.0.0
# Production módot az `npm start` kapcsolja be (--production), külön beállítani nem kell.

# Legalább 32 véletlen karakter. Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cseréje az összes admin munkamenetet érvényteleníti.
JWT_SECRET=

# A nyilvános cím, https://-sel (a levelekben lévő lemondási és admin hivatkozásokhoz).
# Railway-en elhagyható, ha a szolgáltatásnak van railway.app domainje (RAILWAY_PUBLIC_DOMAIN);
# saját domain esetén kötelező megadni. Helyben: http://localhost:4173
PUBLIC_SITE_URL=

# --- Admin ----------------------------------------------------------------
# Csak az ELSŐ indításkor használt (ha még nincs admin az adatbázisban). Min. 12 karakter.
# Az első belépés után töröld; jelszócsere: npm run admin:password
ADMIN_USERNAME=mesegombolyag
ADMIN_PASSWORD=
# Johanna értesítéseinek címe (új foglalás, jelentkezés, érdeklődés, lemondás)
ADMIN_EMAIL=mesegombolyag@gmail.com

# --- Levélküldés -------------------------------------------------------------
# resend (ajánlott; Railway Free/Trial/Hobby csomagon az SMTP tiltott) | smtp (Pro csomagtól)
# | file (levélfogó, csak teszt) | fail (hibateszt) | disabled
MAIL_TRANSPORT=resend
RESEND_API_KEY=
# Hitelesített domainről küldő feladó, pl.: Mesegombolyag <ertesites@sajat-domain.hu>
MAIL_FROM=
# SMTP csak Pro csomagtól:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Adatok -------------------------------------------------------------------
# Railway-en a kötet csatolási pontja (RAILWAY_VOLUME_MOUNT_PATH) automatikusan az adatmappa.
# Helyben alapértelmezés: ./data
# DATA_DIR=./data

# --- Opcionális ---------------------------------------------------------------
# CORS_ORIGINS=https://pelda.hu   # csak ha a frontend más domainről hívja az API-t
# TRUST_PROXY=1                   # saját reverse proxy mögött (Railway-en automatikus)
# BASE_PATH=/                     # alútvonal, ha nem a domain gyökeréről fut
